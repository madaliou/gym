// GYMORA database schema.
// Member is the first business model, used by member creation.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MemberGender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
  SUSPENDED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  COACH
}

model Member {
  id                    String       @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?      @unique
  phone                 String?      @unique
  gender                MemberGender @default(UNSPECIFIED)
  dateOfBirth           DateTime?    @db.Date
  photoUrl              String?      @db.Text
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?      @db.Text
  status                MemberStatus @default(ACTIVE)
  subscriptionMonths    Int?
  joinedAt              DateTime       @db.Date
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([status])
  @@index([joinedAt])
}

model Subscription {
  id             String             @id @default(cuid())
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  durationMonths Int
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([memberId, startDate])
  @@index([status, endDate])
  @@index([endDate])
}

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(MANAGER)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([role])
  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
}
